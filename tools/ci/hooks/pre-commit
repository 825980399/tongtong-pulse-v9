#!/bin/sh
# 第126批 T-126c + 第150批 T150-1 / T150-5 + 第162批刀13/14/15 提速
# 门禁链路（任一违规即阻断提交）：
#   1) cw2  静默except + CRCRLF 行尾污染
#   2) cw3-B ctx 陈旧读 = 0（每次提交，覆盖 _ir_→_ir_ 两级调用）
#   3) cw3-A 语义守恒（仅当 organs/brain/PulseInnerWorld.py 变更时）
#   4) T150-5 门禁隔离守卫：CI 门禁文件不得与业务代码同批暂存
#   5) 367 后续 保留名门禁：Windows 保留设备名（NUL/CON/PRN/AUX/COM1-9/LPT1-9）不得被跟踪
#   + 404 刀3 七层自我分析体系自检面板（tools/m404_layer_health_check.py，默认 warn 不阻断）
#      405 刀5 起「模板 ≡ 实装」由 install_precommit_hook.py --check 校验（CI 与手动都可跑）
#   + 406 刀1 hook 模板/实装同步自检（install_precommit_hook.py --check，默认 warn 不阻断）
#
# 第162批提速（刀13/14/15）：
#   刀13 GATE_PATH_SPLIT — 仅文档路径提交跳过全部代码/collect 门禁（登记册+隔离守卫仍执行）
#   刀14 GATE_PARALLEL   — 5 个静态门禁（弃用import/事件字符串/断链/silent_exc arity/legacy装配）并发执行
#   刀15 重锚分类        — 见 commit-msg hook（消息级 A/B 分类 + 归因桶）
# 回退开关（环境变量，默认启用）：
#   GATE_PATH_SPLIT=0   恢复全串行（含文档提交也跑全套）
#   GATE_PARALLEL=0     恢复 5 静态门串行
#   GATE_COLLECT_LEVEL=full  红基线 collect 升级全量（刀9 增量门默认 incremental）

# 强制使用已安装 pytest 的系统 Python（托管 3.13.12 无 pytest，会导致 collect 门禁失效）
PY="D:/Program Files/Python312/python.exe"

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 1

overall=0
fail() {
  echo "[pre-commit] $1" >&2
  overall=1
}

# ===== 第162批刀13 GATE_PATH_SPLIT：路径分级（暂存清单提前计算，供分级+隔离守卫共用）=====
STAGED=$(git diff --cached --name-only)
GATE_PATH_SPLIT="${GATE_PATH_SPLIT:-1}"
SKIP_CODE_GATES=0
if [ "$GATE_PATH_SPLIT" != "0" ]; then
  # 是否含代码/测试/CI 文件（命中即按"就严"跑全套）
  HAS_CODE=$(printf '%s\n' "$STAGED" | grep -E '\.py$|^config\.py$|^main\.py$|^tools/ci/|^tools/ci/baselines/|tests/' || true)
  if [ -z "$HAS_CODE" ]; then
    # 仅文档 / 台账 / md → 跳过代码与 collect 门禁
    HAS_DOCS=$(printf '%s\n' "$STAGED" | grep -E '^docs/|\.md$|^docs/台账/' || true)
    if [ -n "$HAS_DOCS" ]; then
      SKIP_CODE_GATES=1
      echo "[pre-commit] GATE_PATH_SPLIT：仅文档路径，跳过代码/collect 门禁（登记册与隔离守卫仍执行）"
    fi
  fi
fi

# ===== 代码门禁段（刀13：文档提交整段跳过）=====
if [ "$SKIP_CODE_GATES" -ne 1 ]; then

  # --- 1) cw2 静默except + CRCRLF 门禁 ---
  GATE2="$ROOT/tools/ci/cw2_t2e_ci_gate_silent_except.py"
  if [ ! -f "$GATE2" ]; then
    echo "[pre-commit] 未找到 CI gate 脚本：$GATE2" >&2
    exit 1
  fi
  "$PY" "$GATE2" --base HEAD --target worktree
  st=$?
  if [ "$st" -ne 0 ]; then
    fail "cw2 静默except/CRCRLF 门禁未通过。调试：python tools/ci/cw2_t2e_ci_gate_silent_except.py --verbose"
  fi

  # --- 1.5 + 1.7 + 1.8 + 1.9 第162批刀14 GATE_PARALLEL：5 静态门并发 ---
  GATE_DEP="$ROOT/tools/ci/check_deprecated_imports.py"
  GATE_ES="$ROOT/tools/ci/check_event_string_gate.py"
  GATE_BC="$ROOT/tools/ci/check_broken_chain_gate.py"
  GATE_AE="$ROOT/tools/ci/check_silent_exc_arity.py"
  GATE_LA="$ROOT/tools/ci/check_legacy_assembly_gate.py"
  if [ "${GATE_PARALLEL:-1}" != "0" ]; then
    echo "[pre-commit] GATE_PARALLEL：5 静态门并发执行"
    if [ -f "$GATE_DEP" ]; then "$PY" "$GATE_DEP" >/tmp/_pc_dep.log 2>&1 & pid_dep=$!; else pid_dep=""; fi
    if [ -f "$GATE_ES" ];  then "$PY" "$GATE_ES"  >/tmp/_pc_es.log 2>&1  & pid_es=$!;  else pid_es="";  fi
    if [ -f "$GATE_BC" ];  then "$PY" "$GATE_BC"  >/tmp/_pc_bc.log 2>&1  & pid_bc=$!;  else pid_bc="";  fi
    if [ -f "$GATE_AE" ];  then "$PY" "$GATE_AE"  >/tmp/_pc_ae.log 2>&1  & pid_ae=$!;  else pid_ae="";  fi
    if [ -f "$GATE_LA" ];  then "$PY" "$GATE_LA"  >/tmp/_pc_la.log 2>&1  & pid_la=$!;  else pid_la="";  fi
    if [ -n "$pid_dep" ]; then wait "$pid_dep"; st=$?; [ "$st" -ne 0 ] && fail "弃用 import 门禁未通过（详见 /tmp/_pc_dep.log）"; fi
    if [ -n "$pid_es" ];  then wait "$pid_es";  st=$?; [ "$st" -ne 0 ] && fail "事件字符串门禁未通过（详见 /tmp/_pc_es.log）"; fi
    if [ -n "$pid_bc" ];  then wait "$pid_bc";  st=$?; [ "$st" -ne 0 ] && fail "C-8 断链门禁未通过（详见 /tmp/_pc_bc.log）"; fi
    if [ -n "$pid_ae" ];  then wait "$pid_ae";  st=$?; [ "$st" -ne 0 ] && fail "silent_exc arity 门禁未通过（详见 /tmp/_pc_ae.log）"; fi
    if [ -n "$pid_la" ];  then wait "$pid_la";  st=$?; [ "$st" -ne 0 ] && fail "legacy 装配段防回潮门禁未通过（详见 /tmp/_pc_la.log）"; fi
  else
    # 串行回退
    if [ -f "$GATE_DEP" ]; then "$PY" "$GATE_DEP"; st=$?; [ "$st" -ne 0 ] && fail "弃用 import 门禁未通过（新增非豁免 hybrid/structured scheduler import，应改用 parallel_scheduler.get_parallel_scheduler）"; fi
    if [ -f "$GATE_ES" ];  then "$PY" "$GATE_ES";  st=$?; [ "$st" -ne 0 ] && fail "事件字符串门禁未通过（新增裸点分事件名字符串，应改用 const.py 枚举 Class.MEMBER.value）"; fi
    if [ -f "$GATE_BC" ];  then "$PY" "$GATE_BC";  st=$?; [ "$st" -ne 0 ] && fail "C-8 断链门禁未通过（孤岛文件数/零引用入口方法数/零引用 set_* 数 任一较基线上升）"; fi
    if [ -f "$GATE_AE" ];  then "$PY" "$GATE_AE";  st=$?; [ "$st" -ne 0 ] && fail "silent_exc arity 门禁未通过（存在 silent_exc(...) 缺必填 e 实参，应为 silent_exc(e, where=...)）"; fi
    if [ -f "$GATE_LA" ];  then "$PY" "$GATE_LA";  st=$?; [ "$st" -ne 0 ] && fail "legacy 装配段防回潮门禁未通过（legacy 段 _create_organ 调用超基线/停用标注丢失/开关被置 False）"; fi
  fi

  # --- 1.6) B156-0 红基线 · 片1 collect 门禁（刀9 增量门默认；fail-safe 升级全量）---
  GATE_RB="$ROOT/tools/ci/check_red_baseline_gate.py"
  if [ -f "$GATE_RB" ]; then
    "$PY" "$GATE_RB" collect
    st=$?
    if [ "$st" -ne 0 ]; then
      fail "红基线 collect 门禁未通过（收集错误或节点数漂移>±5；详见 python tools/ci/check_red_baseline_gate.py collect）"
    fi
  fi

  # --- 1.9b) 367 后续 T-NUL实证：Windows 保留设备名门禁 ---
  #    只扫 `git ls-files`（已跟踪）：已跟踪的保留名 ⇒ FAIL；未跟踪/被忽略 ⇒ 仅 stderr 警告。
  #    ★挂它的理由**不是**修 ruff panic（340 那条「疑与 NUL 有关」已证伪：同版本 ruff 0.16.5
  #      在 NUL 在/不在 × cache 热/冷 四种条件下输出逐字相同）。挂它是为了防**保留名进版本库**
  #      —— 一旦 commit 进去，checkout 与 CI 在 Windows 上会崩，且无法用 .gitattributes 补救。
  GATE_NUL="$ROOT/tools/ci/check_nul_files_gate.py"
  if [ -f "$GATE_NUL" ]; then
    "$PY" "$GATE_NUL"
    st=$?
    if [ "$st" -ne 0 ]; then
      fail "保留名文件门禁未通过（有 Windows 保留设备名文件被 git 跟踪；详见 python tools/ci/check_nul_files_gate.py）"
    fi
  fi

  # --- 1.10) 第162批刀3 S4 冷索引关系式断言巡检（无冷存/无索引/无 pyarrow/空索引 → SKIP，不阻断）---
  GATE_S4="$ROOT/tools/ci/check_cold_index_relational.py"
  if [ -f "$GATE_S4" ]; then
    "$PY" "$GATE_S4"
    st=$?
    if [ "$st" -ne 0 ]; then
      fail "刀3 S4 冷索引关系式断言未通过（索引与冷存 Parquet 不一致，需修复后提交；详见 python tools/ci/check_cold_index_relational.py）"
    fi
  fi

  # --- 2) cw3-B ctx 陈旧读门禁（每次提交）---
  GATE_B="$ROOT/tools/ci/cw3_ctx_stale_read_gate.py"
  if [ -f "$GATE_B" ]; then
    "$PY" "$GATE_B" --root "$ROOT" --rev WORKTREE
    st=$?
    if [ "$st" -ne 0 ]; then
      fail "cw3-B ctx 陈旧读门禁未通过（陈旧读 > 0）"
    fi
  else
    echo "[pre-commit] 未找到 cw3-B：$GATE_B（跳过）" >&2
  fi

fi  # end SKIP_CODE_GATES

# --- 4) T150-5 门禁隔离守卫：CI 门禁文件与业务代码不得同提交 ---
CI_FILES=$(printf '%s\n' "$STAGED" | grep -E '^tools/ci/|^tools/ci/baselines/' || true)
BIZ_FILES=$(printf '%s\n' "$STAGED" | grep -vE '^tools/ci/|^tools/ci/baselines/' || true)
if [ -n "$CI_FILES" ] && [ -n "$BIZ_FILES" ]; then
  fail "门禁隔离守卫：检测到 CI 门禁文件与业务代码同批暂存（禁止项）。请拆分为独立提交。
  CI 门禁: $(printf '%s' "$CI_FILES" | tr '\n' ' ')
  业务代码: $(printf '%s' "$BIZ_FILES" | tr '\n' ' ')"
fi

# --- 3) cw3-A 语义守恒门禁（仅 IW 变更时）---
IW_CHANGED=$(printf '%s\n' "$STAGED" | grep -E '^organs/brain/(PulseInnerWorld\.py|pulse_inner_world_)' || true)
if [ -n "$IW_CHANGED" ]; then
  GATE_A="$ROOT/tools/ci/cw3_consistency_gate.py"
  if [ -f "$GATE_A" ]; then
    "$PY" "$GATE_A" --root "$ROOT" --base HEAD --target worktree --baseline "$ROOT/tools/ci/baselines/iw_consistency_baseline.json"
    st=$?
    if [ "$st" -ne 0 ]; then
      fail "cw3-A 语义守恒门禁未通过（IW 改动但守恒量漂移且无 delta_reason）"
    fi
  fi
fi

# --- 待裁决登记册完备性校验（每次提交，T150-3）---
REG="$ROOT/tools/ci/check_pending_register.py"
if [ -f "$REG" ]; then
  "$PY" "$REG"
  st=$?
  if [ "$st" -ne 0 ]; then
    fail "待裁决登记册校验未通过（提交被阻断）"
  fi
else
  echo "[pre-commit] 未找到 check_pending_register：$REG（跳过）" >&2
fi

# --- 登记册列完整性校验（每次提交，176批段7-2 · 与 T150-3 登记册完备性同族）---
REGCOLS="$ROOT/tools/ci/check_register_columns.py"
if [ -f "$REGCOLS" ]; then
  "$PY" "$REGCOLS" --root "$ROOT"
  st=$?
  if [ "$st" -ne 0 ]; then
    fail "登记册列完整性校验未通过（须 9 列、P级∈{P0..P3}、到期批次为整数；详见 python tools/ci/check_register_columns.py --root <repo>）"
  fi
else
  echo "[pre-commit] 未找到 check_register_columns：$REGCOLS（跳过）" >&2
fi

# --- 5) 404 刀3 七层自我分析体系自检面板（默认**不阻断**）---
#   为什么默认不阻断：
#     * L4（当天有小时汇总）/ L5（快照新鲜）是**运行时**判据，框架停机时必然 SKIP 或陈旧；
#     * /data/ 整目录被 .gitignore 忽略，干净克隆里七层全无产物 ⇒ 必然 FAIL。
#   把运行时判据做成阻断门 = "停机维护期间禁止提交" + "新克隆一律提交不了"，属自伤。
#   需要严格时：LAYER_HEALTH_GATE=block LAYER_HEALTH_STRICT=1 git commit（SKIP 也算失败）。
#   ★405 刀5 订正（原注释有误，务必别再改回去）：
#     原注释写「本 hook 未纳入版本管理（tools/ci/hooks/ 只版本化了 commit-msg）」——
#     **这是错的**。本文件的模板就是 tools/ci/hooks/pre-commit，早已入库
#     （c4adee56 / 7ad8d6b4 / 1071e384 三笔历史）。真正缺的只是「模板 → 实装」的同步：
#     404 刀3 只改了本机 .git/hooks/pre-commit，没改模板，于是这一步五天没进版本库。
#     现在装/校验统一走 `python tools/ci/install_precommit_hook.py [--check]`，
#     --check 会把「模板落后于实装」直接判非零退出，这类静默缺口不会再潜伏。
if [ "$SKIP_CODE_GATES" -ne 1 ]; then
  LH="$ROOT/tools/m404_layer_health_check.py"
  if [ -f "$LH" ]; then
    LH_ARGS=""
    if [ "${LAYER_HEALTH_STRICT:-0}" = "1" ]; then
      LH_ARGS="--strict"
    fi
    # shellcheck disable=SC2086  # LH_ARGS 需要按空格分词
    "$PY" "$LH" $LH_ARGS
    st=$?
    if [ "$st" -ne 0 ]; then
      if [ "${LAYER_HEALTH_GATE:-warn}" = "block" ]; then
        fail "七层自检未通过（LAYER_HEALTH_GATE=block；调试：$PY tools/m404_layer_health_check.py）"
      else
        echo "[pre-commit] ⚠ 七层自检有未通过项（不阻断；LAYER_HEALTH_GATE=block 可阻断）" >&2
      fi
    fi
  else
    echo "[pre-commit] 未找到七层自检面板：$LH（跳过）" >&2
  fi
fi

# --- 6) 406 刀1 hook 模板 ≡ 实装 同步自检（默认**不阻断**）---
#   405 刀5 给 install_precommit_hook.py 加了 --check：模板 ≠ 实装即非零退出。
#   挂在这里 = 每次提交自动提醒，不必再靠人记得手跑 --check。
#   为什么必须有这道提醒（404 批的真实事故，别把它当形式主义）：
#     404 刀3 往**本机** .git/hooks/pre-commit 加了 30 行七层自检，却没同步回模板，
#     于是「改了本机忘了改模板」潜伏五天；期间那段代码里还写着「本 hook 未纳入版本管理」
#     这句错话自我麻醉，把事故包装成了「已知限制」。
#   默认不阻断的理由同第 5 段：--check 比对的是**本机安装态**，
#     干净克隆 / CI / worktree 里 .git/hooks 未必存在 ⇒ 做成阻断门会「新克隆一律提交不了」。
#   需要严格时：HOOK_SYNC_GATE=block git commit
#   一致时本段**零输出**（--check 的输出被捕获后丢弃，只在不一致时打印）。
if [ "$SKIP_CODE_GATES" -ne 1 ]; then
  HK="$ROOT/tools/ci/install_precommit_hook.py"
  if [ -f "$HK" ]; then
    HK_OUT=$("$PY" "$HK" --check 2>&1)
    st=$?
    if [ "$st" -ne 0 ]; then
      if [ "${HOOK_SYNC_GATE:-warn}" = "block" ]; then
        printf '%s\n' "$HK_OUT" >&2
        fail "hook 模板与实装不同步（HOOK_SYNC_GATE=block；修复：\"$PY\" \"$HK\"）"
      else
        printf '%s\n' "$HK_OUT" >&2
        echo "[pre-commit] ⚠ hook 模板和实装不同步，跑 install_precommit_hook.py 安装（不阻断；HOOK_SYNC_GATE=block 可阻断）" >&2
      fi
    fi
  else
    echo "[pre-commit] 未找到 hook 安装脚本：$HK（跳过）" >&2
  fi
fi

if [ "$overall" -ne 0 ]; then
  echo "[pre-commit] 门禁未通过，提交被阻断。修复后重新提交。" >&2
fi
exit $overall
