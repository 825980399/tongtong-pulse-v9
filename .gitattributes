# 自动检测文本文件并规范化换行符
* text=auto

# Python文件
*.py text eol=lf
*.pyi text eol=lf

# 文档文件
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# 批处理和脚本
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制文件（不转换换行符）
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.7z binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.pyd binary
*.pyc binary
*.parquet binary
*.npz binary
*.onnx binary
*.fst binary
*.mdl binary
