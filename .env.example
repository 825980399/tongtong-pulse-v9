# ============================================================================
# 曈曈 PulseNet v10 — 环境变量配置模板
# ============================================================================
# 用法：
#   1) 复制本文件为 .env（.env 已被 .gitignore 忽略，绝不会入库）
#   2) 填入真实值后，在启动前导出到环境变量，二选一：
#        · Windows PowerShell :  $env:ZHIPU_API_KEY="xxx"; python main.py
#        · 启动脚本 / 系统服务 :  在服务定义里配置 Environment=...
#      （本项目**不强制**依赖 python-dotenv；如需自动加载，请自行 `pip install python-dotenv`
#        并在入口处 `from dotenv import load_dotenv; load_dotenv()`。）
#   3) 全部变量都**可选**：未设置的渠道会被自动跳过，框架仍可正常启动。
#
# ★安全铁律：本文件只放**示例占位符**，任何情况下都不得把真实密钥提交入库。
#   若历史版本曾把密钥明文写入源码，请视为已泄露，必须到对应平台轮转（rotate）。
# ============================================================================

# ---------------------------------------------------------------------------
# 1. LLM 渠道 API Key
# ---------------------------------------------------------------------------
# 智谱（免费渠道，优先使用）
ZHIPU_API_KEY=

# 火山方舟 / 豆包（免费额度渠道：ARK 是当前名称，DOUBAO_API_KEY 为兼容别名）
# 若两者都设置，优先取 ARK_API_KEY。
ARK_API_KEY=
DOUBAO_API_KEY=

# DeepSeek（付费渠道 + advanced_model 高级推理）
DEEPSEEK_API_KEY=

# 兼容层远程 API（REMOTE_API_CONFIG，可选）
TTP_REMOTE_API_KEY=

# newapi 自建网关令牌（仅在启用网关时使用）
NEWAPI_TOKEN=

# ---------------------------------------------------------------------------
# 2. 企业微信（WeCom）机器人凭证
#   环境变量优先级高于 data/config_override.json（该明文文件应尽快弃用）
# ---------------------------------------------------------------------------
WECOM_BOT_ID=
WECOM_SECRET=
WECOM_ADMIN_USERID=

# ---------------------------------------------------------------------------
# 3. 运行/调试开关（全部可选，默认关闭）
# ---------------------------------------------------------------------------
# =1 静默「API Key 缺失」启动检查（测试 / CI 场景）
PULSE_SKIP_KEY_CHECK=0

# =1 打开重复事件追踪（DEBUG）
PULSE_DUP_TRACE=0

# =1 打印渠道 HTTP 请求/响应体（DEBUG，注意会泄露提示词内容）
PULSE_HTTP_DUMP=0

# =1 启用请求去重器（灰度）
PULSE_REQUEST_DEDUP=0
