  "260:         \"\"\"",
  "261:         import hashlib",
  "262:         import json",
  "263:         payload = pulse.get(\"payload\") or {}",
  "264:         payload_key = json.dumps(payload, sort_keys=True, ensure_ascii=False, default=str)",
  "265:         source = pulse.get(\"source_organ\", \"\")",
  "266:         event_type = pulse.get(\"event_type\", \"\")",
  "267:         target = pulse.get(\"target_organ\", \"\") or pulse.get(\"target\", \"\")",
  "268:         intent = pulse.get(\"intent\", \"\") or \"\"",
  "269:         base = f\"{source}|{event_type}|{target}|{intent}|{payload_key}\"",
  "270:         digest = hashlib.sha256(base.encode(\"utf-8\")).hexdigest()[:32]",
  "271:         return f\"biz:{digest}\"",
  "272: ",
