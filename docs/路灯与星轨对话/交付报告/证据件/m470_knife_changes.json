  "knife1_align_strict": {
    "problem": "469 刀2 只校验「整段方法唯一」就把 original 无条件换成整方法，从不核对 original 到底是不是该方法的方法体",
    "old_rule_released": 14,
    "old_rule_released_wrong": 14,
    "wrong_breakdown": {
      "orig_OVERLAP（跨出方法边界）": 1,
      "orig_IN_body（只是方法内一段）": 2,
      "orig_mismatch（与当前方法体不等）": 6,
      "modified_other_method（改名成别的函数）": 5
    },
    "new_rule_released": 0,
    "new_rule_breakdown": {
      "as_is": 6,
      "orig_mismatch": 9,
      "modified_other_method": 5,
      "span_not_found": 2
    },
    "how_rule_works": "用与 self_inspector._read_method_body 同一规则（跳过 docstring）计算 body，只有 original == body 才允许扩成整方法；且 modified 的 def 行方法名必须与补丁 method 一致",
    "why_old_rule_missed_docstring": "旧口径拿「def 之后全部行」当基准，而 original 来自 get_method_body（跳过 docstring），两边差一个 docstring ⇒ 该拒的放行、该放的漏判"
  },
  "knife2_window_reverify": {
    "problem": "verify_fix_from_logs 的 _elapsed < 300 早退分支返回的 dict 没有 undecidable 键，调用方 if _result.get(\"undecidable\") 拿到 None ⇒ 落 else ⇒ runtime_failed + needs_repair + 自动回滚已落地补丁",
    "field_evidence": "实测 3 条补丁「仅运行 289 秒，需至少 300 秒」，只差 11 秒被回滚",
    "fix": "返回 undecidable=True + window_not_reached=True，走既有 needs_reverify 延迟复验",
    "max_reverify": 3,
    "why_no_spin": "reverify_after 每次 +3600s，第二次复验时 _elapsed 必然 > 300s"
  },
